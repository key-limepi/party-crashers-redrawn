# copy this file to .env and fill it in

# set to false for local testing: no formbar login, no digipogs, every tab is its own player and everyone is a mod
# (add ?name=bob to the page url to pick a name). leave it true for real hosting!!
FORMBAR_MODE=false

# formbar server (the one players log in with and pay digipogs on)
FORMBAR_ADDRESS=https://formbar.yorktechapps.com
# where the formbar login page lives (defaults to FORMBAR_ADDRESS)
# FORMBAR_CLIENT_URL=https://formbar.yorktechapps.com

# optional public address of this game; when unset, the request host is used
# URL=https://your-computer-ip:8000
# PORT=8000

# the digipog pool that receives every payment
POOL_ID=0

# digipog costs
ROUND_COST=0 
MALICE_PRICE=10

# malice
MALICE_PER_ROUND=1
MALICE_PER_BUY=1
