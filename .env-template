# Party Crashers Redrawn environment configuration
# Copy this file to .env and fill in your values

# Server port
PORT=8000

# Formbar / digipog integration
FORMBAR_ADDRESS=
FORMBAR_CLIENT_URL=
URL=

# Formbar mode: true = online with formbar, false = local testing (free)
FORMBAR_MODE=true

# Digipog pool ID for malice transfers
POOL_ID=74

# Round cost in digipogs (0 = free)
ROUND_COST=15

# Malice settings
MALICE_PER_ROUND=1
MALICE_PRICE=10
MALICE_PER_BUY=1
